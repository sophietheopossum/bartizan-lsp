{
  "name": "bartizan-lsp-vscode",
  "displayName": "Bartizan",
  "description": "Companion Rust code actions alongside rust-analyzer",
  "version": "0.1.0",
  "publisher": "sophie",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Bartizan",
      "properties": {
        "bartizan.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the bartizan-lsp binary. Leave empty to look for `bartizan-lsp` on PATH."
        },
        "bartizan.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the Bartizan output channel."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
